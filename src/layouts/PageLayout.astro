---
/**
 * The layout the theme's `defaultLayout` option points markdown and MDX pages
 * at. It unwraps frontmatter and hands it to CourseLayout, so an `.mdx` page
 * and an `.astro` page produce the same page furniture.
 */
import CourseLayout from "./CourseLayout.astro";

const { frontmatter, ...direct } = Astro.props;
const props = (frontmatter ?? direct) as Record<string, unknown>;
const { title, description, kicker, ...rest } = props as {
  title: string;
  description?: string;
  kicker?: string;
  [key: string]: unknown;
};
---

<CourseLayout title={title} description={description} kicker={kicker} {...rest}>
  <slot />
</CourseLayout>
