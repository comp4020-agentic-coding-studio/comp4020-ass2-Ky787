---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import WeekHeader from "../../components/WeekHeader.astro";
import WeekRail from "../../components/WeekRail.astro";
import CourseLayout from "../../layouts/CourseLayout.astro";
import { relatedCollections } from "../../site-config";
import { blockForWeek } from "../../lib/course";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session } }));
}

const { session } = Astro.props;
const { Content } = await render(session);
const week = session.data.week;
const block = blockForWeek(week);
const extra = session.data as { question?: string; mode?: string };
---

<CourseLayout
  title={session.data.title}
  documentTitle={`Week ${week}: ${session.data.title} — SLOP8445`}
  kicker={`Week ${String(week).padStart(2, "0")} · Block ${block.numeral} ${block.title}`}
  description={session.data.description ?? undefined}
>
  <WeekHeader week={week} date={session.data.date} mode={extra.mode} question={extra.question} />
  <Content />
  <SpecList spec={session.data.spec} heading="Come to the studio with">
    The studio assumes you have done these. Each is written so you can tell
    whether you have, without asking.
  </SpecList>
  <RelatedContent entry={session} collections={relatedCollections} />
  <WeekRail current={week} />
</CourseLayout>
