---
// The four blocks and what each one establishes. This is the course's spine:
// if the twelve weeks read as twelve articles, this component is the thing
// that was wrong.
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { BLOCKS } from "../lib/course";

const sessions = await getPublishedCollection("sessions");
const byWeek = new Map(sessions.map((session) => [session.data.week, session]));
const lectures = await getPublishedCollection("lectures");
const byId = new Map(lectures.map((lecture) => [lecture.id, lecture]));
---

<div class="sc-arc">
  {
    BLOCKS.map((block) => {
      const lecture = byId.get(block.lecture);
      return (
        <section class="sc-arc__block" aria-labelledby={`arc-${block.id}`}>
          <span class="sc-arc__numeral">Block {block.numeral}</span>
          <h3 class="sc-arc__title" id={`arc-${block.id}`}>
            {block.title}
          </h3>
          <p class="sc-arc__claim">{block.claim}</p>
          <ul class="sc-arc__weeks">
            {block.weeks.map((week) => {
              const session = byWeek.get(week);
              return (
                <li>
                  <span class="sc-rail__n">{String(week).padStart(2, "0")}</span>
                  {session ? (
                    <a href={withBase(`/sessions/${session.id}/`)}>{session.data.title}</a>
                  ) : (
                    `Week ${week}`
                  )}
                </li>
              );
            })}
          </ul>
          {lecture && (
            <p class="sc-arc__claim" style="margin-block-start: 0.6rem;">
              Opens with <a href={withBase(`/lectures/${lecture.id}/`)}>{lecture.data.title}</a>.
            </p>
          )}
        </section>
      );
    })
  }
</div>
