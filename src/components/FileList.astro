---
// The artefacts behind a page, as a list a reader can work through. Sizes are
// recorded when the file is published, so a link that has rotted shows up as a
// build failure rather than a 404 for a student.
import { evidenceInfo, evidenceName, evidenceUrl, formatBytes } from "../lib/evidence";

interface Item {
  /** Manifest id. */
  id: string;
  /** What it is and why it is here. */
  what: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={["sc-files", className]}>
  {
    items.map((item) => (
      <li>
        <a class="sc-files__name" href={evidenceUrl(item.id)}>
          {evidenceName(item.id)}
        </a>
        <span class="sc-files__what" set:html={item.what} />
        <span class="sc-files__size">{formatBytes(evidenceInfo(item.id).bytes)}</span>
      </li>
    ))
  }
</ul>
