---
// A labelled evidence pane: what it is on top, where it came from underneath.
//
// `sources` is structured rather than free HTML so the component applies the
// base path — a root-absolute href written by hand works on localhost and
// 404s on the deployed site.
import { evidenceName, evidenceUrl } from "../lib/evidence";
import { withBase } from "astro-theme-university/url";

interface Source {
  /** Prose before the link, e.g. "Derived from". */
  label?: string;
  /** Manifest id — linked, and labelled with the artefact's filename. */
  id?: string;
  /** Internal page path, base applied. Requires `text`. */
  href?: string;
  /** Link text for an `href`, or trailing prose when neither is set. */
  text?: string;
}

interface Props {
  title: string;
  /** What to look at, shown beside the title. */
  note?: string;
  /** Where the pane's content came from. */
  sources?: Source[];
  /** Extra classes, e.g. `sc-wide`. */
  class?: string;
}

const { title, note, sources = [], class: className } = Astro.props;
---

<figure class:list={["sc-pane", className]}>
  <div class="sc-pane__head">
    <p class="sc-pane__title">{title}</p>
    {note && <span class="sc-pane__note">{note}</span>}
  </div>
  <div class="sc-pane__body"><slot /></div>
  {
    (sources.length > 0 || Astro.slots.has("foot")) && (
      <figcaption class="sc-pane__foot">
        <slot name="foot" />
        {sources.map((source) => (
          <span>
            {source.label && `${source.label} `}
            {source.id && (
              <a href={evidenceUrl(source.id)}>{source.text ?? evidenceName(source.id)}</a>
            )}
            {source.href && <a href={withBase(source.href)}>{source.text ?? source.href}</a>}
            {!source.id && !source.href && source.text}
          </span>
        ))}
      </figcaption>
    )
  }
</figure>
